# manual-hook-v1.7 sisi KernelSU-Next: guard KSU_MANUAL_HOOK di sucompat.c/.h,
# makro KSU_DIRECT_HOOK di ksud_integration.c, opsi Kconfig KSU_MANUAL_HOOK,
# dan core/init.c (panggil sucompat_init/setuid_hook_init di mode manual,
# cegah hook kprobes ganda pada syscall_hook_init/syscall_hook_manager_init).
# Pasangan dari manual-hook-v1.7.patch. Config: KSU_MANUAL_HOOK=y, KSU_SUSFS=n.
# Belum diuji build/boot.
diff --git a/kernel/Kbuild b/kernel/Kbuild
index 4a864771..713b8f33 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -26,8 +26,9 @@ kernelsu-objs += hook/$(KSU_ARCH)/patch_memory.o
 endif
 endif
 
-# Hooks (excluded for SuSFS)
+# Hooks (excluded for SuSFS and manual hook)
 ifneq ($(strip $(CONFIG_KSU_SUSFS)),y)
+ifneq ($(strip $(CONFIG_KSU_MANUAL_HOOK)),y)
 ifeq ($(strip $(CONFIG_KPROBES)),y)
 kernelsu-objs += hook/syscall_event_bridge.o
 kernelsu-objs += hook/syscall_hook_manager.o
@@ -37,6 +38,7 @@ kernelsu-objs += hook/$(KSU_ARCH)/syscall_hook.o
 endif
 endif
 endif
+endif
 
 kernelsu-objs += hook/setuid_hook.o
 kernelsu-objs += extras.o
diff --git a/kernel/Kconfig b/kernel/Kconfig
index e58f4e1d..10b6bd23 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -100,6 +100,15 @@ config KSU_SAMSUNG_NO_PATCH_TEXT
 	  protection rejects fixmap writes. Samsung devices are detected from
 	  the root device-tree compatible property; other devices are unaffected.
 
+config KSU_MANUAL_HOOK
+    bool "KernelSU manual hook mode (tanpa SUSFS)"
+    depends on KSU
+    depends on !KSU_SUSFS
+    default n
+    help
+      Pakai hook yang ditambal langsung ke sumber kernel
+      (kernel-patches/hooks/manual-hook-v1.7.patch), bukan kprobes.
+
 menu "KernelSU - SUSFS"
 config KSU_SUSFS
 	bool "KernelSU addon - SUSFS"
