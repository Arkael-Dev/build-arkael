+static inline long is_exec_adbd(const char *filename)
+{
+    static const char kApexPrefix[] = "/apex/";
+    static const char kAdbdSuffix[] = "/adbd";
+    size_t len;
+
+    if (strstr(filename, "adbd"))
+        pr_info("is_exec_adbd() => filename: %s\n", filename);
+
+    if (strncmp(filename, kApexPrefix, sizeof(kApexPrefix) - 1) != 0)
+        return 0;
+
+    len = strlen(filename);
+    if (len < sizeof(kAdbdSuffix) - 1)
+        return 0;
+
+    return !strcmp(filename + len - (sizeof(kAdbdSuffix) - 1), kAdbdSuffix);
