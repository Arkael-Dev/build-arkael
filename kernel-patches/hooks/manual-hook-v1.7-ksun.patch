diff --git a/kernel/feature/adb_root.c b/kernel/feature/adb_root.c
index e2978d17..205e9858 100644
--- a/kernel/feature/adb_root.c
+++ b/kernel/feature/adb_root.c
@@ -34,6 +34,25 @@ static inline long is_exec_adbd(const char *filename)
     return (susfs_starts_with(filename, "/apex/") &&
                 susfs_ends_with(filename, "/adbd"));
 }
+#elif defined(CONFIG_KSU_MANUAL_HOOK)
+static inline long is_exec_adbd(const char *filename)
+{
+    static const char kApexPrefix[] = "/apex/";
+    static const char kAdbdSuffix[] = "/adbd";
+    size_t len;
+
+    if (strstr(filename, "adbd"))
+        pr_info("is_exec_adbd() => filename: %s\n", filename);
+
+    if (strncmp(filename, kApexPrefix, sizeof(kApexPrefix) - 1) != 0)
+        return 0;
+
+    len = strlen(filename);
+    if (len < sizeof(kAdbdSuffix) - 1)
+        return 0;
+
+    return !strcmp(filename + len - (sizeof(kAdbdSuffix) - 1), kAdbdSuffix);
+}
 #else
 static long is_exec_adbd(const char __user *filename_user)
 {
