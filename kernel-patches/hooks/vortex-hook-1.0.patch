+ * GKI: 5.10 | 6.1 | 6.6
+ * Author: Kingfinik98 <kingfinix98@gmail.com>
+ */
+#include <vortex_hook.h>
+extern bool ksu_input_hook __read_mostly;
+extern int ksu_handle_input_handle_event(unsigned int *, unsigned int *, int *);
+#endif
+
 void input_event(struct input_dev *dev,
          unsigned int type, unsigned int code, int value)
