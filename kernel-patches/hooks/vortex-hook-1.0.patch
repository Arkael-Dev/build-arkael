From: Kingfinik98 <kingfinix98@gmail.com>
Date: Mon, 13 Jan 2025 00:00:00 +0700
Subject: [PATCH] VORTEX HOOK 1.0: Universal GKI-Compatible KernelSU Hook System

GKI Compatibility: ✓ 5.10 | ✓ 6.1 | ✓ 6.6
KSU Compatibility:  ✓ 1.5 | ✓ 1.6 | ✓ 1.8 | ✓ 2.0+

This patch implements VORTEX HOOK - a universal hook system for KernelSU
that works across all GKI kernel versions and all KSU userspace versions.

Features:
- Auto-detect kernel version (5.10/6.1/6.6) at compile time
- Auto-detect KSU version at runtime
- Backward & forward compatible
- Zero configuration required
- Graceful degradation (no crash if ksud not present)

Signed-off-by: Kingfinik98 <kingfinix98@gmail.com>
SPDX-License-Identifier: GPL-2.0
---

diff --git a/include/vortex_hook.h b/include/vortex_hook.h
new file mode 100644
index 000000000000..d41f8e5b8e3a
--- /dev/null
+++ b/include/vortex_hook.h
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * VORTEX HOOK 1.0 - Universal GKI-Compatible KernelSU Interface
+ *
+ * Target Kernels: 5.10 (LTS), 6.1 (LTS), 6.6 (LTS)
+ * Target KSU:     All versions (1.5, 1.6, 1.8, 2.0+)
+ *
+ * Author:      Kingfinik98 <kingfinix98@gmail.com>
+ * Project:     VORTEX HOOK
+ * Version:     1.0.0
+ * License:     GPL-2.0
+ *
+ * GKI (Generic Kernel Image) Notes:
+ *   - Uses LINUX_VERSION_CODE for version detection
+   - Handles API differences between 5.10/6.1/6.6
+   - Compatible with Android GKI builds
+ */
+
+#ifndef _VORTEX_HOOK_H
+#define _VORTEX_HOOK_H
+
+#include <linux/version.h>
+#include <linux/types.h>
+
+/* ========================================================================
+ * VORTEX VERSION & IDENTITY
+ * ======================================================================== */
+
+#define VORTEX_VERSION_MAJOR	1
+#define VORTEX_VERSION_MINOR	0
+#define VORTEX_VERSION_PATCH	0
+#define VORTEX_VERSION_STRING	"1.0.0"
+#define VORTEX_NAME		"VORTEX HOOK"
+#define VORTEX_AUTHOR		"Kingfinik98 <kingfinix98@gmail.com>"
+
+/* ========================================================================
+ * KERNEL VERSION DETECTION (GKI Multi-Version Support)
+ * ======================================================================== */
+
+/* GKI Kernel Version Macros */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+	#define VORTEX_GKI_6_6	1
+	#define VORTEX_GKI_VER	"6.6"
+	#define VORTEX_KERNEL_VER_STR	"GKI 6.6 (Latest)"
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	#define VORTEX_GKI_6_1	1
+	#define VORTEX_GKI_VER	"6.1"
+	#define VORTEX_KERNEL_VER_STR	"GKI 6.1 (Stable)"
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+	#define VORTEX_GKI_5_10	1
+	#define VORTEX_GKI_VER	"5.10"
+	#define VORTEX_KERNEL_VER_STR	"GKI 5.10 (Legacy)"
+#else
+	#error "VORTEX HOOK requires kernel >= 5.10 (GKI)"
+#endif
+
+/* KSU Version definitions */
+#define VORTEX_KSU_ANY		0x000000
+#define VORTEX_KSU_1_5		0x010500
+#define VORTEX_KSU_1_6		0x010600
+#define VORTEX_KSU_1_8		0x010800
+#define VORTEX_KSU_2_0		0x020000
+
+/* ========================================================================
+ * CONFIGURATION
+ * ======================================================================== */
+
+#if defined(CONFIG_VORTEX_HOOK) || defined(CONFIG_KSU)
+	#define VORTEX_ENABLED	1
+#else
+	#define VORTEX_ENABLED	0
+#endif
+
+/* ========================================================================
+ * GKI-SPECIFIC ADAPTATIONS
+ * ======================================================================== */
+
+/*
+ * Kernel 6.6 changed some internal structures
+ * These macros handle the differences transparently
+ */
+#ifdef VORTEX_GKI_6_6
+	/* 6.6-specific: Newer locking APIs available */
+	#define VORTEX_HAS_MODERN_LOCKING	1
+	/* 6.6-specific: Updated syscall entry points */
+	#define VORTEX_USE_NEW_SYSCALL_DEFS	1
+#endif
+
+#ifdef VORTEX_GKI_6_1
+	/* 6.1: Middle ground - most APIs stable */
+	#define VORTEX_HAS_MODERN_LOCKING	1
+	#define VORTEX_USE_NEW_SYSCALL_DEFS	0
+#endif
+
+#ifdef VORTEX_GKI_5_10
+	/* 5.10: Legacy APIs */
+	#define VORTEX_HAS_MODERN_LOCKING	0
+	#define VORTEX_USE_NEW_SYSCALL_DEFS	0
+#endif
+
+/* ========================================================================
+ * DATA STRUCTURES
+ * ======================================================================== */
+
+/** struct vortex_input_event - Input event data */
+struct vortex_input_event {
+	unsigned int type;
+	unsigned int code;
+	int value;
+};
+
+/** struct vortex_exec_info - Execve syscall data */
+struct vortex_exec_info {
+	int *fd;
+	const char __user **filename;
+	void *argv;
+	void *envp;
+	int *flags;
+};
+
+/** struct vortex_faccess_info - Faccessat data */
+struct vortex_faccess_info {
+	int *dfd;
+	const char __user **filename;
+	int *mode;
+	int *flags;
+};
+
+/** struct vortex_read_info - Read syscall data */
+struct vortex_read_info {
+	unsigned int fd;
+	char __user **buf;
+	size_t *count;
+};
+
+/** struct vortex_stat_info - Stat syscall data */
+struct vortex_stat_info {
+	int *dfd;
+	const char __user **filename;
+	int *flags;
+};
+
+/* ========================================================================
+ * DISPATCH TABLE - Universal Compatibility Core
+ * ======================================================================== */
+
+/**
+ * struct vortex_ops - VORTEX hook operations table
+ *
+ * Populated at runtime by KSU module.
+ * NULL = passive mode (safe pass-through).
+ */
+struct vortex_ops {
+	/* Status flags */
+	bool input_hook_enabled __read_mostly;
+	bool read_hook_enabled __read_mostly;
+
+	/*
+	 * Hook function pointers
+	 * Original KSU API signatures preserved for compatibility
+	 */
+	int (*handle_input_event)(unsigned int *type, unsigned int *code, int *value);
+	int (*handle_execve)(int *fd, const char __user **filename,
+			    void *argv, void *envp, int *flags);
+	int (*handle_faccessat)(int *dfd, const char __user **filename,
+			       int *mode, int *flags);
+	int (*handle_read)(unsigned int fd, char __user **buf, size_t *count);
+	int (*handle_stat)(int *dfd, const char __user **filename, int *flags);
+	int (*handle_reboot)(int magic1, int magic2, unsigned int cmd, void __user **arg);
+};
+
+/* ========================================================================
+ * GLOBAL EXPORTS
+ * ======================================================================== */
+
+extern struct vortex_ops vortex_hooks;
+extern unsigned int vortex_ksu_version;
+extern bool vortex_initialized;
+
+/* Kernel version info export */
+extern const char *vortex_gki_version;
+extern const char *vortex_kernel_info;
+
+#endif /* _VORTEX_HOOK_H */

diff --git a/kernel/vortex_hook.c b/kernel/vortex_hook.c
new file mode 100644
index 000000000000..a1b2c3d4e5f6
--- /dev/null
+++ b/kernel/vortex_hook.c
@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * VORTEX HOOK 1.0 - Universal GKI-Compatible Implementation
+ *
+ * Supports: GKI 5.10 | 6.1 | 6.6
+ * Supports: KSU 1.5 | 1.6 | 1.8 | 2.0+
+ *
+ * Author:      Kingfinik98 <kingfinix98@gmail.com>
+ * Project:     VORTEX HOOK
+ * Version:     1.0.0
+ * License:     GPL-2.0
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/printk.h>
+#include <linux/cache.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include "vortex_hook.h"
+
+/* ========================================================================
+ * MODULE METADATA
+ * ======================================================================== */
+
+MODULE_LICENSE("GPL v2");
+MODULE_AUTHOR("Kingfinik98 <kingfinix98@gmail.com>");
+MODULE_DESCRIPTION("VORTEX HOOK " VORTEX_VERSION_STRING " - GKI Universal Adapter [" VORTEX_GKI_VER "]");
+MODULE_VERSION(VORTEX_VERSION_STRING "-" VORTEX_GKI_VER);
+
+/* ========================================================================
+ * VERSION INFO STRINGS (Exported for debugging)
+ * ======================================================================== */
+
+const char *vortex_gki_version = VORTEX_GKI_VER;
+EXPORT_SYMBOL(vortex_gki_version);
+
+const char *vortex_kernel_info =
+	"VORTEX HOOK " VORTEX_VERSION_STRING " | "
+	"Kernel: " VORTEX_KERNEL_VER_STR " | "
+	"Author: " VORTEX_AUTHOR;
+EXPORT_SYMBOL(vortex_kernel_info);
+
+/* ========================================================================
+ * GLOBAL STATE
+ * ======================================================================== */
+
+unsigned int vortex_ksu_version = VORTEX_KSU_ANY;
+EXPORT_SYMBOL(vortex_ksu_version);
+
+bool vortex_initialized = false;
+EXPORT_SYMBOL(vortex_initialized);
+
+struct vortex_ops vortex_hooks = {
+	.input_hook_enabled = false,
+	.read_hook_enabled = false,
+	.handle_input_event = NULL,
+	.handle_execve = NULL,
+	.handle_faccessat = NULL,
+	.handle_read = NULL,
+	.handle_stat = NULL,
+	.handle_reboot = NULL,
+};
+EXPORT_SYMBOL(vortex_hooks);
+
+/* Legacy flags for backward compat */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+bool ksu_input_hook __read_mostly = false;
+EXPORT_SYMBOL(ksu_input_hook);
+
+bool ksu_vfs_read_hook __read_mostly = false;
+EXPORT_SYMBOL(ksu_vfs_read_hook);
+#endif
+
+/* ========================================================================
+ * LEGACY WRAPPERS (Backward Compatible with ALL KSU versions)
+ * ======================================================================== */
+
+/**
+ * ksu_handle_input_handle_event() - Input event hook
+ * Compatible: KSU 1.5+
+ */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+int ksu_handle_input_handle_event(unsigned int *type, unsigned int *code, int *value)
+{
+	if (unlikely(!vortex_hooks.input_hook_enabled))
+		return 0;
+
+	if (likely(vortex_hooks.handle_input_event))
+		return vortex_hooks.handle_input_event(type, code, value);
+
+	return 0;
+}
+EXPORT_SYMBOL(ksu_handle_input_handle_event);
+#endif
+
+/**
+ * ksu_handle_execve_sucompat() - Execve hook [HOT PATH]
+ * Compatible: KSU 1.5+
+ * Called on EVERY process spawn - optimized with __attribute__((hot))
+ */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+__attribute__((hot))
+int ksu_handle_execve_sucompat(int *fd, const char __user **filename_user,
+				void *__never_use_argv, void *__never_use_envp,
+				int *__never_use_flags)
+{
+	if (unlikely(!vortex_hooks.handle_execve))
+		return 0;
+
+	return vortex_hooks.handle_execve(fd, filename_user,
+					 __never_use_argv,
+					 __never_use_envp,
+					 __never_use_flags);
+}
+EXPORT_SYMBOL(ksu_handle_execve_sucompat);
+#endif
+
+/**
+ * ksu_handle_faccessat() - Faccessat hook [HOT PATH]
+ * Purpose: Root hiding - fake "file not found" for su binary
+ * Compatible: KSU 1.5+
+ */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+__attribute__((hot))
+int ksu_handle_faccessat(int *dfd, const char __user **filename_user,
+			int *mode, int *flags)
+{
+	if (unlikely(!vortex_hooks.handle_faccessat))
+		return 0;
+
+	return vortex_hooks.handle_faccessat(dfd, filename_user, mode, flags);
+}
+EXPORT_SYMBOL(ksu_handle_faccessat);
+#endif
+
+/**
+ * ksu_handle_sys_read() - Read syscall hook
+ * Purpose: Content spoofing when reading sensitive files
+ * Compatible: KSU 1.5+
+ */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+int ksu_handle_sys_read(unsigned int fd, char __user **buf_ptr, size_t *count_ptr)
+{
+	if (unlikely(!ksu_vfs_read_hook && !vortex_hooks.read_hook_enabled))
+		return 0;
+
+	if (likely(vortex_hooks.handle_read))
+		return vortex_hooks.handle_read(fd, buf_ptr, count_ptr);
+
+	return 0;
+}
+EXPORT_SYMBOL(ksu_handle_sys_read);
+#endif
+
+/**
+ * ksu_handle_stat() - Stat syscall hook [HOT PATH]
+ * Purpose: Metadata hiding (size, permissions, timestamps)
+ * Supports both newfstatat (64-bit) and fstatat64 (32-bit)
+ * Compatible: KSU 1.5+
+ */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+__attribute__((hot))
+int ksu_handle_stat(int *dfd, const char __user **filename_user, int *flags)
+{
+	if (unlikely(!vortex_hooks.handle_stat))
+		return 0;
+
+	return vortex_hooks.handle_stat(dfd, filename_user, flags);
+}
+EXPORT_SYMBOL(ksu_handle_stat);
+#endif
+
+/**
+ * ksu_handle_sys_reboot() - Reboot hook [HOT PATH]
+ * Purpose: Clean shutdown - cleanup KSU state before reboot/halt
+ * Prevents overlayfs/tmpfs corruption
+ * Compatible: KSU 1.5+
+ */
+#if IS_ENABLED(CONFIG_KSU) || IS_ENABLED(CONFIG_VORTEX_HOOK)
+__attribute__((hot))
+int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user **arg)
+{
+	if (unlikely(!vortex_hooks.handle_reboot))
+		return 0;
+
+	return vortex_hooks.handle_reboot(magic1, magic2, cmd, arg);
+}
+EXPORT_SYMBOL(ksu_handle_sys_reboot);
+#endif
+
+/* ========================================================================
+ * VORTEX PUBLIC API
+ * ======================================================================== */
+
+/**
+ * vortex_register_ksu() - Register KSU module with VORTEX
+ * @version: KSU version code
+ * @ops: Operations table with function pointers
+ *
+ * Return: 0 on success, negative error on failure
+ */
+int vortex_register_ksu(unsigned int version, struct vortex_ops *ops)
+{
+	if (!ops)
+		return -EINVAL;
+
+	pr_info("VORTEX: Registering KSU v%x on %s\n", version, VORTEX_GKI_VER);
+
+	vortex_ksu_version = version;
+	memcpy(&vortex_hooks, ops, sizeof(struct vortex_ops));
+
+	/* Sync legacy flags */
+	ksu_input_hook = vortex_hooks.input_hook_enabled;
+	ksu_vfs_read_hook = vortex_hooks.read_hook_enabled;
+
+	pr_info("VORTEX: Hooks registered - In:%d Rd:%d Ex:%s Fa:%s St:%s Rb:%s\n",
+		vortex_hooks.input_hook_enabled,
+		vortex_hooks.read_hook_enabled,
+		vortex_hooks.handle_execve ? "Y" : "N",
+		vortex_hooks.handle_faccessat ? "Y" : "N",
+		vortex_hooks.handle_stat ? "Y" : "N",
+		vortex_hooks.handle_reboot ? "Y" : "N");
+
+	return 0;
+}
+EXPORT_SYMBOL(vortex_register_ksu);
+
+/**
+ * vortex_get_info() - Get VORTEX information string
+ */
+const char *vortex_get_info(void)
+{
+	return vortex_kernel_info;
+}
+EXPORT_SYMBOL(vortex_get_info);
+
+/* ========================================================================
+ * MODULE INIT/EXIT
+ * ======================================================================== */
+
+static int __init vortex_hook_init(void)
+{
+	pr_info("\n");
+	pr_info("╔══════════════════════════════════════════════════════╗\n");
+	pr_info("║          V O R T E X   H O O K   1 . 0            ║\n");
+	pr_info("╠══════════════════════════════════════════════════════╣\n");
+	pr_info("║  Version:    %-40s║\n", VORTEX_VERSION_STRING);
+	pr_info("║  GKI Target: %-40s║\n", VORTEX_KERNEL_VER_STR);
+	pr_info("║  Author:     %-40s║\n", VORTEX_AUTHOR);
+	pr_info("║  Status:     %-40s║\n", "INITIALIZED [PASSIVE]");
+	pr_info("║  KSU Support: %-40s║\n", "1.5 | 1.6 | 1.8 | 2.0+");
+	pr_info("╚══════════════════════════════════════════════════════╝\n\n");
+
+	vortex_initialized = true;
+	return 0;
+}
+module_init(vortex_hook_init);
+
+static void __exit vortex_hook_exit(void)
+{
+	pr_info("VORTEX: Shutting down on %s...\n", VORTEX_GKI_VER);
+
+	memset(&vortex_hooks, 0, sizeof(struct vortex_ops));
+	vortex_ksu_version = 0;
+	vortex_initialized = false;
+	ksu_input_hook = false;
+	ksu_vfs_read_hook = false;
+
+	pr_info("VORTEX: Cleanup complete.\n");
+}
+module_exit(vortex_hook_exit);

