+#endif
+
     if (is_event_supported(type, dev->evbit, EV_MAX)) {
         spin_lock_irqsave(&dev->event_lock, flags);

diff --git a/fs/exec.c b/fs/exec.c
index 1c46b79ea152..06e78052886a 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -2119,11 +2119,31 @@ void set_dumpable(struct mm_struct *mm, int value)
     set_mask_bits(&mm->flags, MMF_DUMPABLE_MASK, value);
 }
 
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+/*
+ * VORTEX HOOK 1.0 - Process Execution Interception [CRITICAL PATH]
+ * GKI: 5.10 | 6.1 | 6.6
+ * This is where root access begins - catches 'su' execution
+ * Author: Kingfinik98 <kingfinix98@gmail.com>
+ */
+#include <vortex_hook.h>
+__attribute__((hot))
+extern int ksu_handle_execve_sucompat(int *, const char __user **,
+				void *, void *, int *);
+#endif
+
 SYSCALL_DEFINE3(execve,
         const char __user *, filename,
         const char __user *const __user *, argv,
         const char __user *const __user *, envp)
 {
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+	/* VORTEX EXECVE HOOK - 64-bit path */
+	ksu_handle_execve_sucompat((int *)AT_FDCWD, &filename, NULL, NULL, NULL);
+#endif
     return do_execve(getname(filename), argv, envp);
 }
 
@@ -2143,6 +2163,14 @@ COMPAT_SYSCALL_DEFINE3(execve, const char __user *, filename,
     const compat_uptr_t __user *, argv,
     const compat_uptr_t __user *, envp)
 {
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+	/*
+	 * VORTEX EXECVE HOOK - 32-bit compatibility path
+	 * Required for: 32-bit ksud, 32-on-64 apps
+	 * GKI 5.10/6.1/6.6 all support this
+	 */
+	ksu_handle_execve_sucompat((int *)AT_FDCWD, &filename, NULL, NULL, NULL);
+#endif
     return compat_do_execve(getname(filename), argv, envp);
 }

diff --git a/fs/open.c b/fs/open.c
index e658cdfd88b9..59d8472e1584 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -527,8 +527,22 @@ static long do_faccessat(int dfd, const char __user *filename, int mode, int fla
     return res;
 }
 
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+/*
+ * VORTEX HOOK 1.0 - File Access Check (Root Hiding)
+ * GKI: 5.10 | 6.1 | 6.6
+ * Fakes "file not found" when apps scan for su binary
+ * Author: Kingfinik98 <kingfinix98@gmail.com>
+ */
+#include <vortex_hook.h>
+__attribute__((hot))
+extern int ksu_handle_faccessat(int *, const char __user **, int *, int *);
+#endif
+
 SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 {
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+	ksu_handle_faccessat(&dfd, &filename, &mode, NULL);
+#endif
     return do_faccessat(dfd, filename, mode, 0);
 }

diff --git a/fs/read_write.c b/fs/read_write.c
index d09df87367c5..2726a51bf5b3 100644
--- a/fs/read_write.c
+++ b/fs/read_write.c
@@ -618,8 +618,23 @@ ssize_t ksys_read(unsigned int fd, char __user *buf, size_t count)
     return ret;
 }
 
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+/*
+ * VORTEX HOOK 1.0 - File Read Interception (Content Spoofing)
+ * GKI: 5.10 | 6.1 | 6.6
+ * Returns empty/fake content when apps read sensitive files
+ * Author: Kingfinik98 <kingfinix98@gmail.com>
+ */
+#include <vortex_hook.h>
+extern bool ksu_vfs_read_hook __read_mostly;
+extern int ksu_handle_sys_read(unsigned int, char __user **, size_t *);
+#endif
+
 SYSCALL_DEFINE3(read, unsigned int, fd, char __user *, buf, size_t count)
 {
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+	if (unlikely(ksu_vfs_read_hook || vortex_hooks.read_hook_enabled))
+		ksu_handle_sys_read(fd, &buf, &count);
+#endif
     return ksys_read(fd, buf, count);
 }

diff --git a/fs/stat.c b/fs/stat.c
index 517fa4ed885e..3897c02cd2ee 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -453,6 +453,18 @@ SYSCALL_DEFINE2(newlstat, const char __user *, filename,
     return cp_new_stat(&stat, statbuf);
 }
 
+#if defined(CONFIG_KSU) || defined(CONFIG_VORTEX_HOOK)
+/*
+ * VORTEX HOOK 1.0 - Stat Interception (Metadata Hiding)
+ * GKI: 5.10 | 6.1 | 6.6
+ * Supports: newfstatat (64-bit) + fstatat64 (32-bit)
+ * Author: Kingfinik98 <kingfinix98@gmail.com>
